{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Debug",
      "type": "cppdbg",
      "MIMode": "gdb",
      "request": "launch",
      "args": ["${relativeFileDirname}/test.txt", "${workspaceFolder}/test_result.txt"],
      "cwd": "/home/xande/Projects/Advent23",
